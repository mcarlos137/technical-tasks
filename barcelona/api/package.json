{
  "name": "celebreak-games-api",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL API for pick-up games (Explore screens + Games Q&A agent)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "seed:sql": "tsx src/seed-sql.ts > db/migrations/0002_seed_games.sql"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.23.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
